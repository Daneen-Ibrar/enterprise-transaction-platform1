# ===== DATABASE =====
POSTGRES_DB=transaction_platform
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=change_me_in_production

# ===== APPLICATION =====
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ===== FLYWAY =====
FLYWAY_URL=jdbc:postgresql://postgres:5432/transaction_platform
FLYWAY_USER=platform_user
FLYWAY_PASSWORD=change_me_in_production

# ===== REDIS =====
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# ===== TEST USERS (Set these to create test users on startup) =====
TEST_CUSTOMER_EMAIL=customer@test.com
TEST_CUSTOMER_PASSWORD=password123

TEST_MERCHANT_EMAIL=merchant@test.com
TEST_MERCHANT_PASSWORD=password123

TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=password123

TEST_AUDITOR_EMAIL=auditor@test.com
TEST_AUDITOR_PASSWORD=password123

# ===== SECURITY =====
# JWT Secret (if used)
JWT_SECRET=change_me_in_production

# API Key signing secret
WEBHOOK_SIGNING_SECRET=change_me_in_production

# ===== WEBHOOKS =====
WEBHOOK_URL=http://localhost:8081/webhook

# ===== SMTP (Optional) =====
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password

# ===== RATE LIMITING =====
RATE_LIMIT_PAYMENT_REQUESTS=100
RATE_LIMIT_PAYMENT_REQUESTS_WINDOW=60
RATE_LIMIT_READ_REQUESTS=200
RATE_LIMIT_READ_REQUESTS_WINDOW=60

# ===== LOGGING =====
LOG_LEVEL=INFO